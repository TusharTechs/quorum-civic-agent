# secrets & certs — never commit (brief §7)
*.pem
*.crt
*.cer
*.key
.env
.env.*
.aws/

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# packet cache — large PDFs, regenerable (brief §9)
data/cache/
*.pdf

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# runtime session state (interrupts, message history)
data/sessions/

# AgentCore scaffold: local env, build output, nested venvs
deploy/**/.venv/
deploy/agentcore/.env.local
deploy/agentcore/.cli/
deploy/agentcore/cdk/cdk.out/
deploy/agentcore/cdk/node_modules/

# generated report output
data/report.html

# internal production material, not product documentation
notes/video-script.md

# logo scale preview, dev aid
assets/preview.html

# submission copy, internal
notes/devpost.md
notes/post-*.md

# vendored at deploy time by scripts/prepare_deploy.py
deploy/app/quorumAgent/quorum/

# video production material - internal, not published
scripts/scene.py
scripts/build_cards.py
assets/cards/

# deploy transcript, regenerated each run
deploy-run.log
